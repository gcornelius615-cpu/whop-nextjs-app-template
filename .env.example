# PostLabs Picks — required environment variables
# Copy to .env.local for local dev. In Vercel, add each under
# Project Settings -> Environment Variables (all environments).
# Values come from your Whop developer dashboard (whop.com/dashboard -> your app).

# Server-only. Your app's API key. NEVER commit the real value.
WHOP_API_KEY=your_whop_api_key_here

# Server-only. Webhook signing secret from the webhook you create in the
# Whop dashboard. Leave placeholder until webhooks are set up.
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret_here

# Public (exposed to the browser). Your app id, looks like app_XXXXXXXX.
NEXT_PUBLIC_WHOP_APP_ID=app_your_app_id_here
